{
  "Version": "2008-10-17",
  "Statement": [
    {
      "Sid": "S3Write",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ACCOUNT_ID>:role/OtherBucketAccessRole" },
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<BUCKET3_NAME>/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::<ACCOUNT_ID>:role/OtherBucketAccessRole" },
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET3_NAME>"
    }
  ]
}
