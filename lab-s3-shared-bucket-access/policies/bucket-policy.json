{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadForPublicPrefixOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::anycompany-data-<ACCOUNT_ID>/public/*"
    },
    {
      "Sid": "DenyNonHttpsRequests",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::anycompany-data-<ACCOUNT_ID>",
        "arn:aws:s3:::anycompany-data-<ACCOUNT_ID>/*"
      ],
      "Condition": {
        "Bool": { "aws:SecureTransport": "false" }
      }
    }
  ]
}
