{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishReportsAndPublicContent",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": [
        "arn:aws:s3:::anycompany-data-<ACCOUNT_ID>/reports/*",
        "arn:aws:s3:::anycompany-data-<ACCOUNT_ID>/public/*"
      ]
    }
  ]
}
